# =============================================================
#  Kinorum — .gitignore
# =============================================================

# ── Секреты и конфиг окружения ────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Виртуальные окружения
venv/
.venv/
env/
.env/

# mypy / ruff / pytest
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Node / Vite (admin-frontend) ──────────────────────────────
admin-frontend/node_modules/
admin-frontend/.vite/
admin-frontend/dist/

# admin-dist/ КОММИТИМ — это собранный фронт для сервера
# !admin-dist/

# ── Docker ────────────────────────────────────────────────────
# (docker-compose.yml и Dockerfile коммитим)

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Логи ─────────────────────────────────────────────────────
*.log
logs/

# Secret prevention
.env
.env.*
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json
*.bundle
.security-workspaces/
.runtime/

.env*
*.env
*.env.*