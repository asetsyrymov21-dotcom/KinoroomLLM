# Для запуска в Docker (docker-compose up):
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/kinorum

# Для локального запуска (без Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kinorum

# JWT — ОБЯЗАТЕЛЬНО сменить в проде!
SECRET_KEY=kinorum-secret-key-change-in-production

# Superadmin — доступ к созданию кинорумов (нет записи в БД)
# ОБЯЗАТЕЛЬНО сменить перед деплоем!
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-in-production
